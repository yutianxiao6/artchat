# Ignore everything at root
/*

# Keep .gitignore and python project
!/.gitignore
!/python project/
!/.github/
!/.github/**

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Build artifacts
dist/
build/
*.spec

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.env.local

# Android build artifacts
**/android/app/build/
**/android/app/release/
**/android/.gradle/
**/android/build/
**/node_modules/

# Canvas data (user generated)
canvas_data/

# Config with secrets
model_configs.json

# Installer output
installer/

# Temp
*.bak.*
